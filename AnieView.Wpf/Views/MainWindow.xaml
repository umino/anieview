<Window x:Class="AnieView.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AnieView.Wpf.Views"
        xmlns:conv="clr-namespace:AnieView.Wpf.Converters"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" SizeToContent="WidthAndHeight"
        Background="#1E1E1E"
        KeyDown="Window_KeyDown"
        AllowDrop="True" Drop="Window_Drop">
    <Window.Resources>
        <conv:ImageDataToSourceConverter x:Key="ImageDataToSourceConverter"/>
    </Window.Resources>
    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Name="MainScrollViewer">
            <Image Source="{Binding DisplayImage, Converter={StaticResource ImageDataToSourceConverter}}" 
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Stretch="None"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top">
                <Image.LayoutTransform>
                    <TransformGroup>
                        <RotateTransform Angle="{Binding RotationAngle}"/>
                        <ScaleTransform ScaleX="{Binding ScaleX}" ScaleY="{Binding ScaleY}"/>
                    </TransformGroup>
                </Image.LayoutTransform>
            </Image>
        </ScrollViewer>
    </Grid>
</Window>
